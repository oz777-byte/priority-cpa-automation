# Copy to .env.local for local builds, or paste into the Vercel project's
# environment variables. Never commit a filled-in copy.

# ---------- site ----------

# Your domain, no trailing slash. Used for canonical URLs and the sitemap,
# so a wrong value here silently poisons every SEO signal on the site.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

NEXT_PUBLIC_SITE_NAME=OS Tech Ventures
NEXT_PUBLIC_CONTACT_EMAIL=

# preview | live
#
# `preview` is the safe default: the catalog is sample data, so the site marks
# itself as a preview, blocks crawlers, and renders no outbound buy links.
# Only switch to `live` once the affiliate credentials below are real and a
# test click has been confirmed to appear in the order report.
NEXT_PUBLIC_DATA_MODE=preview

# ---------- aliexpress affiliate ----------
# Required only when NEXT_PUBLIC_DATA_MODE=live.
# These are secrets: set them in Vercel, never in the repository.

ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=

# ---------- supabase ----------
# Not needed for the static storefront. Required by the console and the
# catalog sync job.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- redirect service ----------

# Secret for the daily-rotating IP hash. Without it no IP hash is stored at
# all, which is the safe default but loses de-duplication of repeat clicks.
CLICK_IP_SALT=
