# =====================================================================
# Priority CPA Automation — environment template
#
# Copy this file to `.env.local` (in the same folder) and fill in the values.
# `.env.local` is git-ignored. Do NOT commit it. Do NOT paste these values
# in Slack, GitHub, email, or screenshots.
# =====================================================================

# --- Supabase ---------------------------------------------------------
# Find these at: app.supabase.com → your project → Project Settings → API Keys

# Project URL (public). Looks like: https://abcd1234.supabase.co
SUPABASE_URL=

# Publishable key (formerly "anon key"). Safe to ship to a browser.
# Starts with: sb_publishable_...
SUPABASE_PUBLISHABLE_KEY=

# Secret key (formerly "service_role key"). SERVER-SIDE ONLY.
# Bypasses RLS, full DB access. Never ship to a browser.
# Starts with: sb_secret_...
SUPABASE_SECRET_KEY=

# Database password — only needed for direct Postgres connections.
# Optional for now; the JS client uses the keys above.
SUPABASE_DB_PASSWORD=

# Browser-side copies of the public Supabase values (Next.js requires the
# NEXT_PUBLIC_ prefix to expose them to the client bundle).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Azure Document Intelligence (OCR) --------------------------------
# Without these the OCR skill falls back to a mock extractor (confidence 0).
# Find them at: Azure Portal → your Document Intelligence resource → Keys.
AZURE_DOC_INTELLIGENCE_ENDPOINT=
AZURE_DOC_INTELLIGENCE_KEY=

# --- Optional integrations --------------------------------------------
# Bank of Israel FX rates endpoint override (defaults to the public API).
BOI_RATES_URL=

# Shared secret protecting scheduled endpoints (e.g. /api/rates/refresh-boi).
CRON_SECRET=

# Inbound email ingestion (per-company inbox tokens are stored in the DB).
INBOUND_EMAIL_DOMAIN=
INBOUND_EMAIL_SECRET=
